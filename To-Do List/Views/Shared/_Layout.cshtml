<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TaskFlow</title>
    <meta name="description" content="TaskFlow - Premium Productivity App" />
    <meta name="theme-color" content="#6366f1" />

    <!-- Premium Icon Library -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/feather-icons/4.29.0/feather.min.css" />

    <!-- Design System CSS -->
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/premium-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/To_Do_List.styles.css" asp-append-version="true" />
</head>
<body data-theme="light">
    <!-- Modern Navigation Bar -->
    <nav class="navbar">
        <!-- Sidebar Toggle (Mobile) -->
        <button class="navbar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
            <i class="bi bi-list"></i>
        </button>

        <!-- Brand -->
        <a class="navbar-brand" href="/" title="TaskFlow Dashboard">
            <i class="bi bi-lightning-fill"></i>
            <span class="d-none d-md-inline">TaskFlow</span>
        </a>

        <!-- Search Bar -->
        <div class="navbar-search">
            <input type="text" class="form-control" placeholder="Search tasks..." id="searchTasks" />
        </div>

        <!-- Navbar Actions -->
        <div class="navbar-actions">
            <!-- Theme Toggle -->
            <div class="navbar-action-item" id="themeToggle" title="Toggle theme">
                <i class="bi bi-moon-stars-fill"></i>
            </div>

            <!-- Notifications -->
            <div class="navbar-action-item" title="Notifications">
                <i class="bi bi-bell-fill"></i>
                <span class="notification-badge">3</span>
            </div>

            <!-- User Profile -->
            <div class="navbar-profile" id="profileMenu" title="Profile menu">
                <div class="navbar-profile-avatar">U</div>
                <div class="navbar-profile-info">
                    <div class="navbar-profile-name">User</div>
                    <div class="navbar-profile-role">Premium</div>
                </div>
                <i class="bi bi-chevron-down" style="font-size: 0.75rem;"></i>
            </div>
        </div>
    </nav>

    <!-- App Layout Container -->
    <div class="app-layout">
        <!-- Modern Sidebar -->
        <aside class="app-sidebar" id="appSidebar">
            <div class="sidebar-content">
                <!-- Dashboard Section -->
                <div class="sidebar-section">
                    <div class="sidebar-section-title">Dashboard</div>
                    <ul class="sidebar-nav">
                        <li class="sidebar-nav-item">
                            <a href="/" class="sidebar-link active">
                                <i class="bi bi-house-fill"></i>
                                <span class="sidebar-label">Home</span>
                            </a>
                        </li>
                        <li class="sidebar-nav-item">
                            <a href="/" class="sidebar-link">
                                <i class="bi bi-lightning"></i>
                                <span class="sidebar-label">Today</span>
                                <span class="sidebar-badge">3</span>
                            </a>
                        </li>
                        <li class="sidebar-nav-item">
                            <a href="/" class="sidebar-link">
                                <i class="bi bi-calendar-event"></i>
                                <span class="sidebar-label">Calendar</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Tasks Section -->
                <div class="sidebar-section">
                    <div class="sidebar-section-title">Tasks</div>
                    <ul class="sidebar-nav">
                        <li class="sidebar-nav-item">
                            <a href="/" class="sidebar-link">
                                <i class="bi bi-check2-square"></i>
                                <span class="sidebar-label">My Tasks</span>
                                <span class="sidebar-badge">12</span>
                            </a>
                        </li>
                        <li class="sidebar-nav-item">
                            <a href="/" class="sidebar-link">
                                <i class="bi bi-inbox-fill"></i>
                                <span class="sidebar-label">Inbox</span>
                                <span class="sidebar-badge">2</span>
                            </a>
                        </li>
                        <li class="sidebar-nav-item">
                            <a href="/" class="sidebar-link">
                                <i class="bi bi-check-circle-fill"></i>
                                <span class="sidebar-label">Completed</span>
                                <span class="sidebar-badge">48</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Categories Section -->
                <div class="sidebar-section">
                    <div class="sidebar-section-title">Categories</div>
                    <ul class="sidebar-nav">
                        <li class="sidebar-nav-item">
                            <a href="/" class="sidebar-link">
                                <i class="bi bi-tag-fill" style="color: #6366f1;"></i>
                                <span class="sidebar-label">Work</span>
                            </a>
                        </li>
                        <li class="sidebar-nav-item">
                            <a href="/" class="sidebar-link">
                                <i class="bi bi-tag-fill" style="color: #10b981;"></i>
                                <span class="sidebar-label">Personal</span>
                            </a>
                        </li>
                        <li class="sidebar-nav-item">
                            <a href="/" class="sidebar-link">
                                <i class="bi bi-tag-fill" style="color: #f59e0b;"></i>
                                <span class="sidebar-label">Shopping</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Team Section -->
                <div class="sidebar-section">
                    <div class="sidebar-section-title">Teams</div>
                    <ul class="sidebar-nav">
                        <li class="sidebar-nav-item">
                            <a href="/" class="sidebar-link">
                                <i class="bi bi-people-fill"></i>
                                <span class="sidebar-label">Developers</span>
                            </a>
                        </li>
                        <li class="sidebar-nav-item">
                            <a href="/" class="sidebar-link">
                                <i class="bi bi-people-fill"></i>
                                <span class="sidebar-label">Marketing</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Settings Section -->
                <div class="sidebar-section">
                    <div class="sidebar-section-title">Settings</div>
                    <ul class="sidebar-nav">
                        <li class="sidebar-nav-item">
                            <a href="/" class="sidebar-link">
                                <i class="bi bi-gear-fill"></i>
                                <span class="sidebar-label">Settings</span>
                            </a>
                        </li>
                        <li class="sidebar-nav-item">
                            <a href="/" class="sidebar-link">
                                <i class="bi bi-question-circle-fill"></i>
                                <span class="sidebar-label">Help</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Sidebar Footer -->
            <div class="sidebar-footer">
                <button class="sidebar-toggle-btn" id="sidebarCollapseBtn" title="Collapse sidebar">
                    <i class="bi bi-arrow-left"></i>
                </button>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="app-content">
            <div class="container">
                @RenderBody()
            </div>

            <!-- Footer -->
            <footer style="margin-top: auto; border-top: 1px solid var(--color-border); padding: var(--spacing-xl) var(--spacing-lg); text-align: center; color: var(--color-text-tertiary);">
                <p style="margin: 0; font-size: var(--font-size-sm);">
                    &copy; 2026 TaskFlow. Built with <i class="bi bi-heart-fill" style="color: #ef4444;"></i> for productivity lovers.
                </p>
            </footer>
        </main>
    </div>

    <!-- Mobile Bottom Navigation -->
    <nav class="bottom-nav" id="bottomNav">
        <ul class="bottom-nav-list">
            <li class="bottom-nav-item">
                <a href="/" class="bottom-nav-link active">
                    <i class="bi bi-house-fill"></i>
                    <span>Home</span>
                </a>
            </li>
            <li class="bottom-nav-item">
                <a href="/" class="bottom-nav-link">
                    <i class="bi bi-lightning"></i>
                    <span>Today</span>
                </a>
            </li>
            <li class="bottom-nav-item">
                <a href="/" class="bottom-nav-link">
                    <i class="bi bi-calendar-event"></i>
                    <span>Calendar</span>
                </a>
            </li>
            <li class="bottom-nav-item">
                <a href="/" class="bottom-nav-link">
                    <i class="bi bi-gear-fill"></i>
                    <span>Settings</span>
                </a>
            </li>
        </ul>
    </nav>

    <!-- Floating Action Button (Mobile) -->
    <button class="bottom-nav-fab" id="fabButton" title="Add new task">
        <i class="bi bi-plus-lg"></i>
    </button>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>