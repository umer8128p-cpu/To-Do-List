@model ErrorViewModel

@{
    ViewData["Title"] = "Error";
    Layout = User.Identity?.IsAuthenticated == true ? "~/Views/Shared/_AuthenticatedLayout.cshtml" : "~/Views/Shared/_PublicLayout.cshtml";
}

<div style="display: flex; align-items: center; justify-content: center; min-height: 60vh; padding: var(--spacing-8);">
    <div style="text-align: center; max-width: 500px;">
        <div style="font-size: 4rem; margin-bottom: var(--spacing-6);">⚠️</div>

        <h1 style="font-size: 2rem; margin-bottom: var(--spacing-4);">Oops! Something Went Wrong</h1>

        <p style="color: var(--text-secondary); margin-bottom: var(--spacing-4);">
            We encountered an unexpected error. Please try again later.
        </p>

        @if (!string.IsNullOrEmpty(Model?.RequestId))
        {
            <div style="background: var(--bg-secondary); padding: var(--spacing-4); border-radius: var(--radius-lg); margin-bottom: var(--spacing-8); text-align: left;">
                <small class="text-muted">
                    <strong>Request ID:</strong> <code>@Model.RequestId</code>
                </small>
            </div>
        }

        <div style="display: flex; gap: var(--spacing-4); justify-content: center;">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-action="Main" asp-controller="Home" class="btn btn-primary">
                    <i class="bi bi-house"></i> Back to Dashboard
                </a>
            }
            else
            {
                <a asp-action="Index" asp-controller="Home" class="btn btn-primary">
                    <i class="bi bi-house"></i> Back to Home
                </a>
            }
            <a href="javascript:history.back();" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Go Back
            </a>
        </div>
    </div>
</div>
