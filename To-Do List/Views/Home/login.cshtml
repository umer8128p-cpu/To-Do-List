@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<section style="min-height: calc(100vh - 200px); display: flex; align-items: center; justify-content: center; padding: var(--spacing-8);">
    <div style="width: 100%; max-width: 400px;">
        <!-- Card -->
        <div class="card">
            <div class="card-body">
                <!-- Header -->
                <div style="text-align: center; margin-bottom: var(--spacing-8);">
                    <div style="font-size: 2.5rem; margin-bottom: var(--spacing-4);">
                        <i class="bi bi-check-circle-fill" style="color: var(--primary);"></i>
                    </div>
                    <h1 style="font-size: 1.75rem; margin-bottom: var(--spacing-2);">Welcome Back</h1>
                    <p class="text-muted">Sign in to your account to continue</p>
                </div>

                <!-- Error Alert -->
                @if (!string.IsNullOrEmpty(ViewBag.LoginError))
                {
                    <div class="alert alert-danger mb-4">
                        <i class="bi bi-exclamation-circle alert-icon"></i>
                        <div>
                            <strong>Login Failed</strong>
                            <p style="margin: 0;">@ViewBag.LoginError</p>
                        </div>
                    </div>
                }

                <!-- Form -->
                <form asp-action="login" method="post">
                    <!-- Email -->
                    <div class="form-group">
                        <label class="form-label" for="LoginEmail">Email Address</label>
                        <input type="email" class="form-control" id="LoginEmail" name="LoginEmail" placeholder="you@example.com" required>
                    </div>

                    <!-- Password -->
                    <div class="form-group">
                        <label class="form-label" for="LoginPassword">Password</label>
                        <input type="password" class="form-control" id="LoginPassword" name="LoginPassword" placeholder="••••••••" required>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary w-100 mt-4">
                        <i class="bi bi-box-arrow-in-right"></i>
                        Sign In
                    </button>
                </form>

                <!-- Divider -->
                <div style="text-align: center; margin: var(--spacing-6) 0; color: var(--text-tertiary);">
                    <small>Don't have an account?</small>
                </div>

                <!-- Register Link -->
                <a asp-action="register" asp-controller="Home" class="btn btn-secondary w-100">
                    Create an Account
                </a>

                <!-- Back to Home -->
                <div style="text-align: center; margin-top: var(--spacing-6);">
                    <a asp-action="Index" asp-controller="Home" class="text-muted">
                        <i class="bi bi-arrow-left"></i> Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
