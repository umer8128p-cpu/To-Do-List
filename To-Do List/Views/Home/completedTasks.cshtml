@model IEnumerable<To_Do_List.Models.TblTask>

@{
    ViewData["Title"] = "Completed Tasks";
    Layout = "~/Views/Shared/_AuthenticatedLayout.cshtml";
}

<!-- Filters -->
<div class="card mb-6">
    <div class="card-header">
        <h2 style="font-size: 1rem;">🔍 Filter</h2>
    </div>
    <div class="card-body">
        <form method="get" class="grid grid-3" style="gap: var(--spacing-4); align-items: end;">
            <!-- Category Filter -->
            <div class="form-group">
                <label class="form-label">Category</label>
                <select class="form-control form-select" name="id">
                    <option value="0">All Categories</option>
                    @{
                        var categories = ViewBag.categories as List<To_Do_List.Models.TblCategory>;
                        if (categories != null)
                        {
                            foreach (var cat in categories)
                            {
                                var isSelected = ViewBag.SelectedCategory == cat.CategoryId;
                                var selectedAttr = isSelected ? " selected" : "";
                                @Html.Raw($"<option value=\"{cat.CategoryId}\"{selectedAttr}>{cat.CategoryName}</option>")
                            }
                        }
                    }
                </select>
            </div>

            <!-- Date Filter -->
            <div class="form-group">
                <label class="form-label">Completion Date</label>
                <input type="date" class="form-control" name="date" value="@ViewBag.SelectedDate">
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Filter
            </button>
        </form>
    </div>
</div>

<!-- Tasks -->
<div class="card">
    <div class="card-header">
        <div>
            <h1 style="font-size: 1.5rem;">✅ Completed Tasks</h1>
            <small style="color: var(--text-tertiary);">@ViewBag.completedTasks task(s)</small>
        </div>
        <span class="badge badge-success">Done</span>
    </div>

    <div class="card-body">
        @if (Model.Any())
        {
            @foreach (var task in Model)
            {
                <div class="task-card completed">
                    <div class="task-content">
                        <div class="task-title">@task.TaskTitle</div>
                        @if (!string.IsNullOrEmpty(task.TaskDiscription))
                        {
                            <div class="task-description">@task.TaskDiscription</div>
                        }
                        <div class="task-meta">
                            <span class="badge badge-success">✓ Completed</span>
                            @if (!string.IsNullOrEmpty(task.TaskCategoryNavigation?.CategoryName))
                            {
                                <span>🏷️ @task.TaskCategoryNavigation.CategoryName</span>
                            }
                            <span>📅 @task.TaskDate?.ToString("MMM dd yyyy")</span>
                            @if (task.CompletedDate.HasValue)
                            {
                                <span>✓ Completed: @task.CompletedDate?.ToString("MMM dd yyyy")</span>
                            }
                        </div>
                    </div>

                    <div class="task-actions">
                        <form asp-action="updateTaskStatus" asp-controller="Home" method="post" style="display: inline;">
                            <input type="hidden" name="id" value="@task.TaskId">
                            <button type="submit" class="task-btn" title="Mark Pending">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        </form>
                        <a href="@Url.Action("editTask", "Home", new { id = task.TaskId, view = "completedView" })" class="task-btn" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="deleteTask" asp-controller="Home" method="post" style="display: inline;" onsubmit="return confirm('Delete this task?');">
                            <input type="hidden" name="id" value="@task.TaskId">
                            <input type="hidden" name="view" value="completedView">
                            <button type="submit" class="task-btn danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">🎉</div>
                <div class="empty-state-title">No completed tasks yet</div>
                <div class="empty-state-text">Start completing tasks to see them here!</div>
                <a asp-action="NewTask" asp-controller="Home" class="btn btn-primary btn-sm mt-4">➕ Add New Task</a>
            </div>
        }
    </div>
</div>
