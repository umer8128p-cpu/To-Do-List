@{
    ViewData["Title"] = "TaskFlow - Organize Your Tasks";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<section style="padding: var(--spacing-12) var(--spacing-8); text-align: center;">
    <!-- Hero Section -->
    <div style="max-width: 800px; margin: 0 auto;">
        <div style="margin-bottom: var(--spacing-8);">
            <i class="bi bi-check-circle-fill" style="font-size: 4rem; color: var(--primary);"></i>
        </div>

        <h1 style="font-size: 3rem; margin-bottom: var(--spacing-4); color: var(--text-primary);">
            Organize Your Day.<br>
            Get Things Done.
        </h1>

        <p style="font-size: 1.25rem; color: var(--text-secondary); margin-bottom: var(--spacing-8);">
            A powerful and intuitive task management application that helps you stay focused and productive.
        </p>

        <div style="display: flex; gap: var(--spacing-4); justify-content: center; margin-bottom: var(--spacing-12);">
            <a asp-action="register" asp-controller="Home" class="btn btn-primary btn-lg">
                Get Started
            </a>
            <a asp-action="login" asp-controller="Home" class="btn btn-outline-primary btn-lg">
                Login
            </a>
        </div>

        <!-- Illustration -->
        <div style="background: var(--primary-light); padding: var(--spacing-8); border-radius: var(--radius-xl); margin-bottom: var(--spacing-12);">
            <div style="font-size: 5rem; display: flex; justify-content: center; gap: var(--spacing-6);">
                <span style="animation: bounce 2s infinite;">📋</span>
                <span style="animation: bounce 2s infinite; animation-delay: 0.2s;">✓</span>
                <span style="animation: bounce 2s infinite; animation-delay: 0.4s;">🎯</span>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section id="features" style="padding: var(--spacing-12) var(--spacing-8); background: var(--bg-secondary);">
    <div style="max-width: 1200px; margin: 0 auto;">
        <h2 style="text-align: center; margin-bottom: var(--spacing-8); font-size: 2rem;">Features</h2>

        <div class="grid grid-3">
            <!-- Feature 1 -->
            <div class="card">
                <div class="card-body text-center">
                    <div style="font-size: 2.5rem; margin-bottom: var(--spacing-4);">📌</div>
                    <h3 style="margin-bottom: var(--spacing-3);">Manage Tasks</h3>
                    <p>Create, edit, and organize your tasks with ease. Add descriptions, dates, and times.</p>
                </div>
            </div>

            <!-- Feature 2 -->
            <div class="card">
                <div class="card-body text-center">
                    <div style="font-size: 2.5rem; margin-bottom: var(--spacing-4);">⚡</div>
                    <h3 style="margin-bottom: var(--spacing-3);">Set Priorities</h3>
                    <p>Categorize your tasks by priority level to focus on what matters most.</p>
                </div>
            </div>

            <!-- Feature 3 -->
            <div class="card">
                <div class="card-body text-center">
                    <div style="font-size: 2.5rem; margin-bottom: var(--spacing-4);">📊</div>
                    <h3 style="margin-bottom: var(--spacing-3);">Track Progress</h3>
                    <p>Monitor completed tasks and track your productivity over time.</p>
                </div>
            </div>

            <!-- Feature 4 -->
            <div class="card">
                <div class="card-body text-center">
                    <div style="font-size: 2.5rem; margin-bottom: var(--spacing-4);">🏷️</div>
                    <h3 style="margin-bottom: var(--spacing-3);">Organize Categories</h3>
                    <p>Group tasks by categories like work, personal, study, and more.</p>
                </div>
            </div>

            <!-- Feature 5 -->
            <div class="card">
                <div class="card-body text-center">
                    <div style="font-size: 2.5rem; margin-bottom: var(--spacing-4);">🔔</div>
                    <h3 style="margin-bottom: var(--spacing-3);">Filter & Search</h3>
                    <p>Quickly find tasks with powerful filtering by status, date, and category.</p>
                </div>
            </div>

            <!-- Feature 6 -->
            <div class="card">
                <div class="card-body text-center">
                    <div style="font-size: 2.5rem; margin-bottom: var(--spacing-4);">✓</div>
                    <h3 style="margin-bottom: var(--spacing-3);">Mark Complete</h3>
                    <p>Celebrate achievements by marking tasks as complete and viewing your progress.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section id="about" style="padding: var(--spacing-12) var(--spacing-8); text-align: center;">
    <div style="max-width: 600px; margin: 0 auto;">
        <h2 style="margin-bottom: var(--spacing-6); font-size: 2rem;">Ready to Get More Done?</h2>
        <p style="margin-bottom: var(--spacing-8); font-size: 1.125rem;">
            Join thousands of users who are already using TaskFlow to manage their tasks and boost productivity.
        </p>
        <a asp-action="register" asp-controller="Home" class="btn btn-primary btn-lg">
            Create Your Account Now
        </a>
    </div>
</section>


